# Database Configuration (for PostgreSQL)
# Uncomment and configure if using PostgreSQL instead of SQLite

# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=your_username
# DB_PASSWORD=your_password
# DB_NAME=real_estate_db

# Alternatively, provide full connection string
# DATABASE_URL=postgresql://user:password@localhost:5432/real_estate_db

# Scraping Configuration
DEFAULT_CONCURRENT_LIMIT=5
DEFAULT_QUALITY_THRESHOLD=50
DEFAULT_TIMEOUT=30

# Logging
LOG_LEVEL=INFO
